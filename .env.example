# Copy to .env and fill in. Nothing here is required for the offline default path.

# Alerting (webhook delivery is dry-run unless RELIABILITY_ALERT_DRY_RUN=false)
RELIABILITY_WEBHOOK_URL=https://hooks.example.com/services/REPLACE_ME
RELIABILITY_ALERT_DRY_RUN=true
PAGERDUTY_ROUTING_KEY=REPLACE_ME

# Incident summarizer: rule_based (default, offline) | bedrock | azure_openai
RELIABILITY_SUMMARIZER=rule_based

# AWS Bedrock (credentials via the standard AWS chain, never in this file in prod)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=REPLACE_WITH_MODEL_ID

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://REPLACE_ME.openai.azure.com
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=REPLACE_ME
AZURE_OPENAI_API_VERSION=2024-06-01
